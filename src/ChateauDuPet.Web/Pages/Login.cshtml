@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container-lg py-5">
    <div class="row justify-content-center align-items-center g-5">
        <div class="col-md-5 d-none d-md-block">
            <img src="~/img/undraw_mobile_login_ikmv.svg" class="img-fluid" alt="" />
        </div>
        <div class="col-md-5">
            <h1 class="mb-1">Entrar</h1>
            <p class="text-muted">Empresas, profissionais e administradores usam o mesmo acesso.</p>

            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                @if (Model.Erro is { } erro)
                {
                    <div class="alert alert-danger">@erro</div>
                }
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="username" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Senha" class="form-label">Senha</label>
                    <input asp-for="Senha" type="password" class="form-control" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn btn-danger w-100">Entrar</button>
            </form>

            <p class="mt-3">Ainda não tem conta? <a href="/Cadastro" class="text-danger">Cadastre-se</a></p>

            <div class="contas-demo mt-4">
                <strong>Contas de demonstração</strong> (senha <code>demo1234</code>)
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-email="felipe@@exemplo.com">Empresa</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-email="jucelino@@exemplo.com">Profissional</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-email="admin@@exemplo.com">Administrador</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-email]').forEach(botao => botao.addEventListener('click', () => {
            document.getElementById('Email').value = botao.dataset.email;
            document.getElementById('Senha').value = 'demo1234';
        }));
    </script>
}
