@page
@model ServicosModel
@{
    ViewData["Title"] = "Serviços";
    var planos = new[]
    {
        (Titulo: "Profissional", Imagem: "undraw_mobile_login_ikmv.svg",
         Itens: new[] { "Currículo online", "Inscrição em vagas", "Acompanhamento das candidaturas" }),
        (Titulo: "Empresas", Imagem: "undraw_People_search_re_5rre.svg",
         Itens: new[] { "Publicação de vagas", "Relatório de candidatos", "Consulta de dados para contato" })
    };
    var recursos = new[]
    {
        (Titulo: "Privacidade", Imagem: "undraw_Security_on_re_e491.svg",
         Texto: "Seus dados de contato só aparecem para empresas cadastradas na plataforma."),
        (Titulo: "Perfil", Imagem: "undraw_Wall_post_re_y78d.svg",
         Texto: "Personalize seu perfil: as empresas estão sempre visualizando os currículos, então mantenha o seu atualizado para ter mais retorno."),
        (Titulo: "Comunidade", Imagem: "undraw_Connected_re_lmq2.svg",
         Texto: "Conecte-se: são várias empresas que compartilham vagas para profissionais e estudantes. Compartilhe suas experiências e certificados."),
        (Titulo: "Contato direto", Imagem: "undraw_Personal_email_re_4lx7.svg",
         Texto: "Quando o seu perfil chamar atenção, a empresa entra em contato com você por e-mail ou telefone.")
    };
}

<div class="Centro container-xxl py-4" style="margin: auto;">
    <div class="row g-4 justify-content-center">
        @foreach (var plano in planos)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="plano p-2">
                    <img src="~/img/@plano.Imagem" class="ilustracao mb-3" alt="" />
                    <h2>@plano.Titulo</h2>
                    <ul class="list-unstyled">
                        @foreach (var item in plano.Itens)
                        {
                            <li>
                                <p class="d-flex align-items-start gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-bookmark-check-fill flex-shrink-0" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M2 15.5V2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.74.439L8 13.069l-5.26 2.87A.5.5 0 0 1 2 15.5zm8.854-9.646a.5.5 0 0 0-.708-.708L7.5 7.793 6.354 6.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0l3-3z" />
                                    </svg>
                                    <span>@item</span>
                                </p>
                            </li>
                        }
                    </ul>
                    <a href="/Cadastro" class="btn btn-outline-danger">Plano Gratuito</a>
                </div>
            </div>
        }
    </div>

    <hr class="featurette-divider my-4">

    <div class="row g-4">
        @foreach (var recurso in recursos)
        {
            <div class="col-sm-6 col-lg-3">
                <img src="~/img/@recurso.Imagem" class="ilustracao mb-3" alt="" />
                <h3 class="h5 mb-1">@recurso.Titulo</h3>
                <p class="text-muted">@recurso.Texto</p>
            </div>
        }
    </div>
</div>
