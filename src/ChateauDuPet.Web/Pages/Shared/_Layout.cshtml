<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string titulo ? $"{titulo} · Chateau" : "Chateau")</title>
    <link href="~/img/pp.png" rel="icon" type="image/png" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/padrao.css" rel="stylesheet" />
    <link href="~/css/animacoes.css" rel="stylesheet" />
    <link href="~/css/home.css" rel="stylesheet" />
    <link href="~/css/w3.css" rel="stylesheet" />
    <link href="~/css/chateau.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="container-fluid">
    <div class="faixa-demo">
        Versão de demonstração (portfólio): não é o site oficial do Chateau Du Pet.
        <a href="/Sobre#demo">Saiba mais</a>
    </div>

        <header>
            <nav class="navbar navbar-expand-md navbar-light     container-xxl ">
                <div class="container-lg">
                    <a href="/" class="navbar-brand p-0" aria-label="Chateau Du Pet: página inicial">
                        <img src="~/img/pp.png" width="100" style="max-height: 500px;" class="d-block my-1" alt="Chateau Du Pet" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav menu    ">
                            <li class="nav-item col-6 col-md-auto">
                                <a class="nav-link p-2" href="/">Home</a>
                            </li>
                            <li class="nav-item col-6 col-md-auto">
                                <a class="nav-link p-2" href="/Servicos">Serviços</a>
                            </li>
                            <li class="nav-item col-6 col-md-auto">
                                <a class="nav-link p-2" href="/Vagas">Vagas</a>
                            </li>
                            <li class="nav-item col-6 col-md-auto">
                                <a class="nav-link p-2" href="/Sobre">Sobre</a>
                            </li>

                            <partial name="_BotoesContaMobile" />
                        </ul>
                    </div>
                </div>
                <partial name="_BotoesConta" />
            </nav>
        </header>

        <partial name="_Termos" />

    <main>
        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="alert alert-success container-lg mt-3">@mensagem</div>
        }
        @RenderBody()
    </main>

