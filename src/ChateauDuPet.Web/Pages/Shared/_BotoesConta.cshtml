@using ChateauDuPet.Web
<div class="botoes-conta d-none d-md-flex">
    @if (User.Logado() is { } usuario)
    {
        <a class="btn btn-outline-danger" href="@usuario.PainelUrl()">Meu painel</a>
        <form method="post" asp-page="/Sair" class="m-0">
            <button type="submit" class="btn btn-outline-danger">Sair</button>
        </form>
    }
    else
    {
        <a class="btn btn-outline-danger" href="/Login">Login</a>
        <a class="btn btn-outline-danger" href="/Cadastro">Cadastro</a>
    }
</div>
