@page
@model ChateauDuPet.Web.Pages.Profissional.IndexModel
@{
    ViewData["Title"] = "Meu painel";
}

<div class="container-lg py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
            <partial name="_Avatar" model="(Model.Perfil.UrlImage, Model.Perfil.DsSexo, 72)" />
            <h1 class="mb-0"># Olá, @Model.Perfil.NmProfissional.Split(' ')[0]</h1>
        </div>
        <div class="d-flex gap-2">
            <a href="/Profissionais/@Model.Perfil.IdProfissional" class="btn btn-outline-secondary">Ver meu perfil público</a>
            <a asp-page="Perfil" class="btn btn-danger">Editar currículo</a>
        </div>
    </div>
    <hr />

    @if (Model.PerfilIncompleto)
    {
        <div class="alert alert-warning">
            Seu currículo ainda está vazio. <a asp-page="Perfil" class="alert-link">Adicione biografia, experiências e certificados</a>
            para as empresas conhecerem você.
        </div>
    }

    <h3 class="h4 mb-3">Minhas candidaturas</h3>
    @if (Model.Candidaturas.Count == 0)
    {
        <p class="lead">Você ainda não se candidatou a nenhuma vaga.</p>
    }
    else
    {
        <div class="list-group mb-4">
            @foreach (var c in Model.Candidaturas)
            {
                <a href="/Vagas/@c.FKVaga" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span><strong>@c.NmVaga</strong> · @c.NomeEmpresa</span>
                    <small class="text-muted">@c.DsData.ToString("dd/MM/yyyy")</small>
                </a>
            }
        </div>
    }

    <h3 class="h4 mt-4 mb-3">Vagas abertas</h3>
    <hr class="featurette-divider">
    <div class="row">
        @foreach (var vaga in Model.Vagas.Take(6))
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <strong class="text-danger small">@vaga.NomeEmpresa</strong>
                        <h5 class="card-title">@vaga.NmVaga</h5>
                        <p class="card-text flex-grow-1">@vaga.DsDescricao</p>
                        <a href="/Vagas/@vaga.IdVaga" class="btn btn-primary align-self-start">Ver mais</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <a href="/Vagas" class="text-danger">Ver todas as vagas &rarr;</a>
</div>
