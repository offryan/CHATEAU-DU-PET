@page
@model SobreModel
@{
    ViewData["Title"] = "Sobre";
}
@section Head {
    <link href="~/css/sobre.css" rel="stylesheet" />
}

<div class="Centro container-xxl" style="margin: auto;">

    <div class="row mb-2">
        <div class="col-md-6 pt-3">
                <div id="carouselExampleIndicators" class="carousel slide carrossel-sobre" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/img/1624081833559.jpg" class="d-block w-100" alt="Unidade Chateau Du Pet" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/img/1624082007356.jpg" class="d-block w-100" alt="Unidade Chateau Du Pet" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/img/1624081878901.jpg" class="d-block w-100" alt="Unidade Chateau Du Pet" />
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Próximo</span>
                    </button>
                </div>
        </div>

        <div class="col-md-6">
            <div class="row g-0 rounded overflow-hidden flex-md-row mb-4 h-md-250 position-relative">
                <div class="CentroContato container-xxl" style="width: 90%;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
                        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2zm13 2.383-4.758 2.855L15 11.114v-5.73zm-.034 6.878L9.271 8.82 8 9.583 6.728 8.82l-5.694 3.44A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.739zM1 11.114l4.758-2.876L1 5.383v5.73z"></path>
                    </svg>
                    <span class="menu">
                        <a style="color: black;" id="Contato">E-mail</a>
                    </span>
                    <hr />

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-warning"></div>

                        <label asp-for="Contato.Nome" class="lead">Nome</label>
                        <input asp-for="Contato.Nome" class="form-control" style="width: 90%;" />
                        <span asp-validation-for="Contato.Nome" class="text-danger"></span>
                        <br />

                        <label asp-for="Contato.Email" class="lead">E-mail</label>
                        <input asp-for="Contato.Email" class="form-control" maxlength="100" style="width: 90%;" />
                        <span asp-validation-for="Contato.Email" class="text-danger"></span>
                        <br />

                        <label asp-for="Contato.Telefone" class="lead">Telefone</label>
                        <input asp-for="Contato.Telefone" class="form-control" maxlength="20" style="width: 90%;" />
                        <span asp-validation-for="Contato.Telefone" class="text-danger"></span>
                        <br />

                        <label asp-for="Contato.Mensagem" class="lead">Mensagem</label>
                        <textarea asp-for="Contato.Mensagem" class="form-control" style="width: 90%; height: 120px;"></textarea>
                        <span asp-validation-for="Contato.Mensagem" class="text-danger"></span>
                        <br />

                        <button type="submit" class="Btn btn btn-secondary">Enviar</button>
                    </form>

                    @if (Model.Enviado)
                    {
                        <p class="lead mt-3">
                            Mensagem recebida! Como esta é uma versão de demonstração, ela não é enviada por e-mail.
                        </p>
                    }
                    <br /><br />
                </div>
            </div>
        </div>
    </div>

    <section id="demo" class="sobre-demo mb-5">
        <h2># Sobre esta demonstração</h2>
        <hr />
        <p>
            O Chateau Du Pet foi o nosso TCC: uma plataforma para empresas do ramo pet publicarem vagas e
            encontrarem profissionais. O cliente real comprou apenas o site institucional, que está em
            <a href="https://www.chateaudupet.com.br">chateaudupet.com.br</a>.
            <strong>Esta página não é o site oficial</strong>: é a plataforma de vagas publicada como portfólio,
            com dados fictícios.
        </p>
        <p>
            A versão original era ASP.NET Web Forms com SQL Server. Esta versão foi migrada para
            <strong>.NET 8 (Razor Pages)</strong> com <strong>PostgreSQL no Supabase</strong> e roda em um
            container Docker no <strong>Render</strong>, mantendo a arquitetura em camadas (DTO, DAL e BLL).
        </p>
        <p class="mb-1">
            Contas para testar (senha <code>demo1234</code>). Fique à vontade para mexer: os dados de
            demonstração são restaurados todos os dias às 3h.
        </p>
        <ul>
            <li>Empresa: <code>felipe@@exemplo.com</code></li>
            <li>Profissional: <code>jucelino@@exemplo.com</code></li>
            <li>Administrador: <code>admin@@exemplo.com</code></li>
        </ul>
        <p>
            Código no GitHub: <a href="https://github.com/offryan/CHATEAU-DU-PET">offryan/CHATEAU-DU-PET</a>.
        </p>
    </section>
</div>
